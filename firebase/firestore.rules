rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// Collection: analyses
// Document ID: {analysisId} (UUID or sanitized string slug, 1-128 chars)
// Fields:
//   - id: string (required, 1-128 chars, matches document ID, immutable)
//   - analysis_id: string (optional, 1-128 chars, matches document ID, immutable)
//   - topic: string (required, 1-500 chars)
//   - executive_summary: string (optional, max 20,000 chars)
//   - key_metrics_and_numbers: list of strings (optional, max 50 items)
//   - consensus_points: list of strings (optional, max 50 items)
//   - timeline: map (optional, structured events & narrative shift)
//   - contradictions: list of maps (optional, max 50 items)
//   - verifications: list of maps (optional, max 50 items)
//   - bias_evaluations: list of maps (optional, max 50 items)
//   - root_cause_analysis: map (optional, triggers & systemic factors)
//   - consequences_tree: list of maps (optional, max 50 items)
//   - future_scenarios: list of maps (optional, max 50 items)
//   - lessons_learned: list of maps (optional, max 50 items)
//   - sources_analyzed: list of strings (optional, max 50 items)
//   - evidence_ledger: list of maps (optional, max 200 items)
//   - chat_history: list of maps (optional, max 200 items)
//   - image_prompts: list of strings (optional, max 20 items)
//   - raw_markdown: string (optional, max 100,000 chars)
//   - created_at: number | timestamp (optional, immutable)
//   - updated_at: number | timestamp (optional)
//   - uid: string (optional, 1-128 chars, matches author auth.uid, immutable)
//   - author: string (optional, max 100 chars)
//   - status: string (optional, max 50 chars)
//
// Collection: fact_checks
// Document ID: {checkId} (UUID or sanitized string slug, 1-128 chars)
// Fields:
//   - id: string (required, 1-128 chars, matches document ID, immutable)
//   - check_id: string (optional, 1-128 chars, matches document ID, immutable)
//   - claim: string (required, 1-1000 chars)
//   - topic: string (optional, max 500 chars)
//   - report_markdown: string (optional, max 100,000 chars)
//   - evidence_ledger: list of maps (optional, max 200 items)
//   - verifications: list of maps (optional, max 50 items)
//   - consensus_summary: string (optional, max 5,000 chars)
//   - overall_verdict_summary: string (optional, max 5,000 chars)
//   - total_claims_audited: number (optional, >= 0)
//   - created_at: number | timestamp (optional, immutable)
//   - updated_at: number | timestamp (optional)
//   - uid: string (optional, 1-128 chars, matches author auth.uid, immutable)
//
// Collection: quizzes
// Document ID: {quizId} (UUID or sanitized string slug, 1-128 chars)
// Fields:
//   - id: string (required, 1-128 chars, matches document ID, immutable)
//   - quiz_id: string (optional, 1-128 chars, matches document ID, immutable)
//   - topic: string (required, 1-500 chars)
//   - questions: list of maps (optional, max 50 items)
//   - score_percentage: number (optional, 0 to 100)
//   - correct_count: number (optional, >= 0)
//   - total_questions: number (optional, >= 0)
//   - user_answers: map (optional, question index to selected option)
//   - feedback: list of maps (optional, max 50 items)
//   - created_at: number | timestamp (optional, immutable)
//   - updated_at: number | timestamp (optional)
//   - uid: string (optional, 1-128 chars, matches author auth.uid, immutable)
//
// Collection: debates
// Document ID: {debateId} (UUID or sanitized string slug, 1-128 chars)
// Fields:
//   - id: string (required, 1-128 chars, matches document ID, immutable)
//   - debate_id: string (optional, 1-128 chars, matches document ID, immutable)
//   - topic: string (required, 1-500 chars)
//   - resolution_under_debate: string (optional, max 2,000 chars)
//   - debate_turns: list of maps (optional, max 50 items)
//   - neutral_compromise_synthesis: string (optional, max 10,000 chars)
//   - created_at: number | timestamp (optional, immutable)
//   - updated_at: number | timestamp (optional)
//   - uid: string (optional, 1-128 chars, matches author auth.uid, immutable)
//
// Collection: evidence_ledger
// Document ID: {ledgerId} (UUID or sanitized string slug, 1-128 chars)
// Fields:
//   - id: string (required, 1-128 chars, matches document ID, immutable)
//   - entries: list of maps (required, max 500 items)
//   - created_at: number | timestamp (optional, immutable)
//   - updated_at: number | timestamp (optional)
//   - uid: string (optional, 1-128 chars, matches author auth.uid, immutable)
//
// Collection: chat_history
// Document ID: {analysisId} (UUID or sanitized string slug, 1-128 chars)
// Fields:
//   - id: string (optional, 1-128 chars, matches document ID, immutable)
//   - analysis_id: string (required, 1-128 chars, matches document ID, immutable)
//   - messages: list of maps (required, max 200 items)
//   - created_at: number | timestamp (optional, immutable)
//   - updated_at: number | timestamp (optional)
//   - uid: string (optional, 1-128 chars, matches author auth.uid, immutable)
//
// Collection: topic_suggestions
// Document ID: {suggestionId} (e.g. 'latest' or sanitized string slug, 1-128 chars)
// Fields:
//   - id: string (optional, 1-128 chars, matches document ID, immutable)
//   - countries: list of maps (required, max 50 items)
//   - created_at: number | timestamp (optional, immutable)
//   - created_at_iso: string (optional, max 100 chars)
//   - updated_at: number | timestamp (optional)
//   - expires_at: number | timestamp (optional)
//   - cache_duration_seconds: number (optional, >= 0)
//   - is_stale: bool (optional)
//   - age_seconds: number (optional, >= 0)
//   - uid: string (optional, 1-128 chars, matches author auth.uid, immutable)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if client is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check administrative privileges via verified custom claims or bootstrap emails
    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.get('admin', false) == true ||
         request.auth.token.get('email', '') in ['admin@agenticnews.dev', 'admin@agentic-news.app']);
    }

    // Verify creator UID consistency on create
    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    // Verify creator UID cannot be reassigned on update
    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        !('uid' in resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    // Verify immutable fields are not changed during update
    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // Generic schema validation helpers
    function isValidOptionalString(data, field, minLen, maxLen) {
      return !(field in data) ||
        (data[field] is string &&
         data[field].size() >= minLen &&
         data[field].size() <= maxLen);
    }

    function isValidOptionalList(data, field, maxSize) {
      return !(field in data) ||
        (data[field] is list && data[field].size() <= maxSize);
    }

    function isValidOptionalMap(data, field) {
      return !(field in data) || (data[field] is map);
    }

    function isValidOptionalTime(data, field) {
      return !(field in data) ||
        (data[field] is number || data[field] is timestamp);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidAnalysis(data, analysisId) {
      return data.keys().hasAll(['id', 'topic']) &&
        data.keys().hasOnly([
          'id', 'analysis_id', 'topic', 'executive_summary',
          'key_metrics_and_numbers', 'consensus_points', 'timeline',
          'contradictions', 'verifications', 'bias_evaluations',
          'root_cause_analysis', 'consequences_tree', 'future_scenarios',
          'lessons_learned', 'sources_analyzed', 'evidence_ledger',
          'chat_history', 'generated_articles', 'generated_images', 'image_prompts', 'quiz', 'debate', 'is_favorite', 'notes',
          'raw_markdown', 'created_at', 'updated_at', 'uid', 'author', 'status'
        ]) &&
        data.id is string && data.id == analysisId &&
        data.id.size() >= 1 && data.id.size() <= 128 &&
        (!('analysis_id' in data) || (data.analysis_id is string && data.analysis_id == analysisId)) &&
        data.topic is string && data.topic.size() >= 1 && data.topic.size() <= 500 &&
        isValidOptionalString(data, 'executive_summary', 0, 20000) &&
        isValidOptionalList(data, 'key_metrics_and_numbers', 50) &&
        isValidOptionalList(data, 'consensus_points', 50) &&
        isValidOptionalMap(data, 'timeline') &&
        isValidOptionalList(data, 'contradictions', 50) &&
        isValidOptionalList(data, 'verifications', 50) &&
        isValidOptionalList(data, 'bias_evaluations', 50) &&
        isValidOptionalMap(data, 'root_cause_analysis') &&
        isValidOptionalList(data, 'consequences_tree', 50) &&
        isValidOptionalList(data, 'future_scenarios', 50) &&
        isValidOptionalList(data, 'lessons_learned', 50) &&
        isValidOptionalList(data, 'sources_analyzed', 50) &&
        isValidOptionalList(data, 'evidence_ledger', 200) &&
        isValidOptionalList(data, 'chat_history', 200) &&
        isValidOptionalList(data, 'generated_articles', 100) &&
        isValidOptionalList(data, 'generated_images', 100) &&
        isValidOptionalList(data, 'image_prompts', 20) &&
        isValidOptionalString(data, 'raw_markdown', 0, 100000) &&
        isValidOptionalTime(data, 'created_at') &&
        isValidOptionalTime(data, 'updated_at') &&
        isValidOptionalString(data, 'uid', 1, 128) &&
        isValidOptionalString(data, 'author', 0, 100) &&
        isValidOptionalString(data, 'status', 0, 50);
    }

    function isValidFactCheck(data, checkId) {
      return data.keys().hasAll(['id', 'claim']) &&
        data.keys().hasOnly([
          'id', 'check_id', 'claim', 'topic', 'report_markdown',
          'evidence_ledger', 'verifications', 'consensus_summary',
          'overall_verdict_summary', 'total_claims_audited',
          'created_at', 'updated_at', 'uid'
        ]) &&
        data.id is string && data.id == checkId &&
        data.id.size() >= 1 && data.id.size() <= 128 &&
        (!('check_id' in data) || (data.check_id is string && data.check_id == checkId)) &&
        data.claim is string && data.claim.size() >= 1 && data.claim.size() <= 1000 &&
        isValidOptionalString(data, 'topic', 0, 500) &&
        isValidOptionalString(data, 'report_markdown', 0, 100000) &&
        isValidOptionalList(data, 'evidence_ledger', 200) &&
        isValidOptionalList(data, 'verifications', 50) &&
        isValidOptionalString(data, 'consensus_summary', 0, 5000) &&
        isValidOptionalString(data, 'overall_verdict_summary', 0, 5000) &&
        (!('total_claims_audited' in data) || (data.total_claims_audited is number && data.total_claims_audited >= 0)) &&
        isValidOptionalTime(data, 'created_at') &&
        isValidOptionalTime(data, 'updated_at') &&
        isValidOptionalString(data, 'uid', 1, 128);
    }

    function isValidQuiz(data, quizId) {
      return data.keys().hasAll(['id', 'topic']) &&
        data.keys().hasOnly([
          'id', 'quiz_id', 'topic', 'questions',
          'score_percentage', 'correct_count', 'total_questions',
          'user_answers', 'feedback',
          'created_at', 'updated_at', 'uid'
        ]) &&
        data.id is string && data.id == quizId &&
        data.id.size() >= 1 && data.id.size() <= 128 &&
        (!('quiz_id' in data) || (data.quiz_id is string && data.quiz_id == quizId)) &&
        data.topic is string && data.topic.size() >= 1 && data.topic.size() <= 500 &&
        isValidOptionalList(data, 'questions', 50) &&
        (!('score_percentage' in data) || (data.score_percentage is number && data.score_percentage >= 0 && data.score_percentage <= 100)) &&
        (!('correct_count' in data) || (data.correct_count is number && data.correct_count >= 0)) &&
        (!('total_questions' in data) || (data.total_questions is number && data.total_questions >= 0)) &&
        isValidOptionalMap(data, 'user_answers') &&
        isValidOptionalList(data, 'feedback', 50) &&
        isValidOptionalTime(data, 'created_at') &&
        isValidOptionalTime(data, 'updated_at') &&
        isValidOptionalString(data, 'uid', 1, 128);
    }

    function isValidDebate(data, debateId) {
      return data.keys().hasAll(['id', 'topic']) &&
        data.keys().hasOnly([
          'id', 'debate_id', 'topic', 'resolution_under_debate',
          'debate_turns', 'neutral_compromise_synthesis',
          'created_at', 'updated_at', 'uid'
        ]) &&
        data.id is string && data.id == debateId &&
        data.id.size() >= 1 && data.id.size() <= 128 &&
        (!('debate_id' in data) || (data.debate_id is string && data.debate_id == debateId)) &&
        data.topic is string && data.topic.size() >= 1 && data.topic.size() <= 500 &&
        isValidOptionalString(data, 'resolution_under_debate', 0, 2000) &&
        isValidOptionalList(data, 'debate_turns', 50) &&
        isValidOptionalString(data, 'neutral_compromise_synthesis', 0, 10000) &&
        isValidOptionalTime(data, 'created_at') &&
        isValidOptionalTime(data, 'updated_at') &&
        isValidOptionalString(data, 'uid', 1, 128);
    }

    function isValidEvidenceLedger(data, ledgerId) {
      return data.keys().hasAll(['id', 'entries']) &&
        data.keys().hasOnly(['id', 'entries', 'created_at', 'updated_at', 'uid']) &&
        data.id is string && data.id == ledgerId &&
        data.id.size() >= 1 && data.id.size() <= 128 &&
        data.entries is list && data.entries.size() <= 500 &&
        isValidOptionalTime(data, 'created_at') &&
        isValidOptionalTime(data, 'updated_at') &&
        isValidOptionalString(data, 'uid', 1, 128);
    }

    function isValidChatHistory(data, analysisId) {
      return data.keys().hasAll(['analysis_id', 'messages']) &&
        data.keys().hasOnly(['id', 'analysis_id', 'messages', 'created_at', 'updated_at', 'uid']) &&
        data.analysis_id is string &&
        data.analysis_id == analysisId &&
        data.analysis_id.size() >= 1 &&
        data.analysis_id.size() <= 128 &&
        (!('id' in data) || (data.id is string && data.id == analysisId && data.id.size() >= 1 && data.id.size() <= 128)) &&
        data.messages is list &&
        data.messages.size() <= 200 &&
        isValidOptionalTime(data, 'created_at') &&
        isValidOptionalTime(data, 'updated_at') &&
        isValidOptionalString(data, 'uid', 1, 128);
    }

    function isValidTopicSuggestions(data, suggestionId) {
      return data.keys().hasAll(['countries']) &&
        (('updated_at' in data) || ('created_at' in data)) &&
        data.keys().hasOnly([
          'id', 'countries', 'created_at', 'created_at_iso', 'updated_at',
          'expires_at', 'cache_duration_seconds', 'is_stale', 'age_seconds', 'uid'
        ]) &&
        (!('id' in data) || (data.id is string && data.id == suggestionId && data.id.size() >= 1 && data.id.size() <= 128)) &&
        data.countries is list &&
        data.countries.size() <= 50 &&
        isValidOptionalTime(data, 'created_at') &&
        isValidOptionalString(data, 'created_at_iso', 0, 100) &&
        isValidOptionalTime(data, 'updated_at') &&
        isValidOptionalTime(data, 'expires_at') &&
        (!('cache_duration_seconds' in data) || (data.cache_duration_seconds is number && data.cache_duration_seconds >= 0)) &&
        (!('is_stale' in data) || data.is_stale is bool) &&
        (!('age_seconds' in data) || (data.age_seconds is number && data.age_seconds >= 0)) &&
        isValidOptionalString(data, 'uid', 1, 128);
    }

    function isValidArticle(data, articleId) {
      return data.keys().hasAll(['id', 'analysis_id', 'topic', 'headline', 'content_markdown']) &&
        data.id is string && data.id == articleId &&
        data.id.size() >= 1 && data.id.size() <= 128 &&
        data.analysis_id is string && data.analysis_id.size() >= 1 && data.analysis_id.size() <= 128 &&
        data.topic is string && data.topic.size() <= 1000 &&
        data.headline is string && data.headline.size() <= 500 &&
        data.content_markdown is string && data.content_markdown.size() <= 100000 &&
        isValidOptionalTime(data, 'created_at') &&
        isValidOptionalTime(data, 'updated_at');
    }

    function isValidImage(data, imageId) {
      return data.keys().hasAll(['id', 'analysis_id', 'prompt', 'image_url']) &&
        data.id is string && data.id == imageId &&
        data.id.size() >= 1 && data.id.size() <= 128 &&
        data.analysis_id is string && data.analysis_id.size() >= 1 && data.analysis_id.size() <= 128 &&
        data.prompt is string && data.prompt.size() <= 5000 &&
        data.image_url is string && data.image_url.size() <= 2000 &&
        isValidOptionalTime(data, 'created_at') &&
        isValidOptionalTime(data, 'updated_at');
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // 1. Analyses: Multi-agent intelligence reports
    match /analyses/{analysisId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
                    isValidAnalysis(request.resource.data, analysisId) &&
                    uidUnchanged();
      allow update: if isAuthenticated() &&
                    isValidAnalysis(request.resource.data, analysisId) &&
                    uidNotModified() &&
                    areImmutableFieldsUnchanged(['id', 'created_at']) &&
                    (!('uid' in resource.data) || resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() &&
                    (('uid' in resource.data && resource.data.uid == request.auth.uid) || isAdmin());
    }

    // 2. Fact Checks: Discrete claim verification audits
    match /fact_checks/{checkId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
                    isValidFactCheck(request.resource.data, checkId) &&
                    uidUnchanged();
      allow update: if isAuthenticated() &&
                    isValidFactCheck(request.resource.data, checkId) &&
                    uidNotModified() &&
                    areImmutableFieldsUnchanged(['id', 'created_at']) &&
                    (!('uid' in resource.data) || resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() &&
                    (('uid' in resource.data && resource.data.uid == request.auth.uid) || isAdmin());
    }

    // 3. Quizzes: Active recall interactive quizzes and literacy attempts
    match /quizzes/{quizId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
                    isValidQuiz(request.resource.data, quizId) &&
                    uidUnchanged();
      allow update: if isAuthenticated() &&
                    isValidQuiz(request.resource.data, quizId) &&
                    uidNotModified() &&
                    areImmutableFieldsUnchanged(['id', 'created_at']) &&
                    (!('uid' in resource.data) || resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() &&
                    (('uid' in resource.data && resource.data.uid == request.auth.uid) || isAdmin());
    }

    // 4. Debates: Perspective debate reports
    match /debates/{debateId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
                    isValidDebate(request.resource.data, debateId) &&
                    uidUnchanged();
      allow update: if isAuthenticated() &&
                    isValidDebate(request.resource.data, debateId) &&
                    uidNotModified() &&
                    areImmutableFieldsUnchanged(['id', 'created_at']) &&
                    (!('uid' in resource.data) || resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() &&
                    (('uid' in resource.data && resource.data.uid == request.auth.uid) || isAdmin());
    }

    // 5. Evidence Ledger: Audit trail logs (strictly append-only, immutable once written)
    match /evidence_ledger/{ledgerId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
                    isValidEvidenceLedger(request.resource.data, ledgerId) &&
                    uidUnchanged();
      allow update: if false; // Audit logs are immutable
      allow delete: if false; // Audit logs cannot be deleted
    }

    // 6. Chat History: Research Copilot conversation history per analysis
    match /chat_history/{analysisId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
                    isValidChatHistory(request.resource.data, analysisId) &&
                    uidUnchanged();
      allow update: if isAuthenticated() &&
                    isValidChatHistory(request.resource.data, analysisId) &&
                    uidNotModified() &&
                    areImmutableFieldsUnchanged(['id', 'analysis_id', 'created_at']) &&
                    (!('uid' in resource.data) || resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() &&
                    (('uid' in resource.data && resource.data.uid == request.auth.uid) || isAdmin());
    }

    // 7. Topic Suggestions: Dynamic country-grouped headline suggestions (cached for fast loading)
    match /topic_suggestions/{suggestionId} {
      allow read: if true;
      allow create: if (isAuthenticated() || isAdmin()) &&
                    isValidTopicSuggestions(request.resource.data, suggestionId) &&
                    uidUnchanged();
      allow update: if (isAuthenticated() || isAdmin()) &&
                    isValidTopicSuggestions(request.resource.data, suggestionId) &&
                    uidNotModified() &&
                    areImmutableFieldsUnchanged(['id', 'created_at']) &&
                    (!('uid' in resource.data) || resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if false;
    }

    // 8. Articles: On-demand customized articles generated from analyses
    match /articles/{articleId} {
      allow read: if true;
      allow create: if isValidArticle(request.resource.data, articleId);
      allow update: if isValidArticle(request.resource.data, articleId);
      allow delete: if true;
    }

    // 9. Images: On-demand generated editorial images from Imagen 3
    match /images/{imageId} {
      allow read: if true;
      allow create: if isValidImage(request.resource.data, imageId);
      allow update: if isValidImage(request.resource.data, imageId);
      allow delete: if true;
    }

    // Default Deny: all unmapped collections and wildcard paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

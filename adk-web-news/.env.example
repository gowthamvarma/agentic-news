# ==============================================================================
# Environment Configuration for News Analyser ADK Agent Fleet
# ==============================================================================

# Provide your Gemini API key below when available:
# If left empty or unset, the system runs in Simulation / Mock Mode.
GEMINI_API_KEY=

# Optional: Google AI Studio / Vertex AI alternative key variable
GOOGLE_API_KEY=

# Logging level: DEBUG, INFO, WARNING, ERROR
ADK_LOG_LEVEL=INFO
